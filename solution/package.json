{
  "name": "@workshop/solution",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.mjs",
    "test": "hardhat test",
    "test:full": "WORKSHOP_FULL_TESTS=1 hardhat test",
    "typecheck": "tsc --noEmit && next typegen frontend && tsc --noEmit -p frontend/tsconfig.json",
    "chain": "hardhat node --no-deploy",
    "deploy:localhost": "hardhat deploy --network localhost",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "check:sepolia": "hardhat run scripts/check-deployment.ts --network sepolia",
    "test:sepolia": "node scripts/test-sepolia.mjs",
    "dev": "cd frontend && next dev --webpack",
    "build": "cd frontend && next build --webpack",
    "start": "cd frontend && next start",
    "lint": "eslint . && solhint \"contracts/**/*.sol\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run compile && npm test && npm run lint && npm run typecheck && npm run build && npm run format:check"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.6.1",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.106.1",
    "@zama-fhe/sdk": "3.7.1",
    "encrypted-types": "0.0.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@tailwindcss/postcss": "4.3.4",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "ethers": "6.16.0",
    "hardhat": "2.28.6",
    "hardhat-deploy": "0.11.45",
    "prettier": "3.8.1",
    "prettier-plugin-solidity": "2.2.1",
    "solc": "0.8.27",
    "solhint": "6.2.5",
    "tailwindcss": "4.3.4",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
