# Browser wallet extensions work without WalletConnect. Add a real project ID for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional server-only override; never use NEXT_PUBLIC_ for credentials.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deploying contracts writes deployment.json automatically. Alternatively set all four below.
PAYROLL_ADDRESS=
PUBLIC_TOKEN_ADDRESS=
CONFIDENTIAL_TOKEN_ADDRESS=
EMPLOYER_ADDRESS=
# Set true for the updated payroll contract; older deployments leave this false.
PAYROLL_TREASURY_VIEWING=true
# Optional address of the earlier payroll; no funds or salary records are migrated.
PREVIOUS_PAYROLL_ADDRESS=
# Sepolia's Zama Relayer does not require an API key.
